{
  "name": "splitmate",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "prisma:migrate": "cd prisma && npx prisma migrate dev",
    "prisma:generate": "cd prisma && npx prisma generate",
    "prisma:studio": "cd prisma && npx prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "test": "npm run test --workspace=apps/api"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.0.0",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.0",
    "pg": "^8.23.0"
  }
}
